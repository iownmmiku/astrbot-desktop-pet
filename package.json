{
  "name": "astrbot-desktop-pet",
  "productName": "AstrBot 桌宠",
  "version": "0.6.0",
  "description": "AstrBot 桌宠桌面端：Live2D 桌宠 + 与 AstrBot 桌宠插件联动（虚拟桌宠模拟器风格）",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "install:electron": "electron --version",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.iownmmiku.astrbotdesktoppet",
    "productName": "AstrBot桌宠",
    "asar": true,
    "compression": "maximum",
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AstrBotDesktopPet-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.3.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
