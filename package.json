{
  "name": "astrbot-desktop-pet",
  "version": "0.8.1",
  "description": "AstrBot Live2D 桌宠 · 稳定性重建版",
  "main": "src/main.js",
  "author": "iownmmiku",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win portable --x64",
    "pack:win": "electron-builder --win --dir --x64"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "com.iownmmiku.astrbot.desktop.pet",
    "productName": "AstrBot 桌宠",
    "asar": true,
    "files": [
      "src/**/*",
      "vendor/**/*",
      "models/**/*",
      "package.json",
      "licenses/**/*",
      "assets-manifest.json",
      "LICENSE*",
      "THIRD_PARTY*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AstrBotDesktopPet-${version}-win-x64.exe"
    }
  }
}
